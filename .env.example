# durable-agent-runtime — defaults run fully offline.
DATABASE_URL=postgresql://runtime:runtime@localhost:55432/runtime

WORKER_SLOTS=4
WORKER_POLL_INTERVAL_S=0.5
WORKER_HEARTBEAT_INTERVAL_S=2
WORKER_STALE_AFTER_S=15
RUN_MAX_ATTEMPTS=3
APPROVAL_TTL_S=3600

# "scripted" = deterministic offline planner (no key). "openai" = any OpenAI-compatible endpoint.
LLM_PROVIDER=scripted
LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=   <- set in your shell or a local .env, never commit it
DEFAULT_MODEL=scripted/planner-v1
